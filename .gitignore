# Environnement Python local (réinstallable via requirements.txt)
.venv/
__pycache__/
*.pyc

# Outil tiers téléchargé (d4lf) - voir HISTORIQUE.md pour la procédure
# d'installation, pas du code du projet, trop volumineux pour un dépôt git
tools/

# Logs et caches locaux
*.log
app/data/kamilabs_cache/

# Build PyInstaller de l'outil de verif d'installation (regenerable, ~11 Mo)
installer/build/
installer/dist/

# Profil navigateur Playwright persistant (InfinityBuilds) - contient de vrais
# cookies de session (Discord/Supabase), ne doit jamais etre commite
.pw-profile-infinitybuilds/

# Artefacts de debug/exploration Playwright (screenshots, dumps JSON/HTML bruts)
scripts/_*

# fixture trop lourde pour le depot public ; regenerer avec scripts/enregistrer_fixtures.py
tests/fixtures/kamilabs/api.json
# genere par scripts/fusion_dictionnaires.py
app/data/dictionnaire_unifie.json
